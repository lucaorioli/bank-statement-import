<odoo>
    <record id="online_bank_statement_provider_form" model="ir.ui.view">
        <field name="name">online.bank.statement.provider.form.field.mapping</field>
        <field name="model">online.bank.statement.provider</field>
        <field
            name="inherit_id"
            ref="account_statement_import_online.online_bank_statement_provider_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="field_mapping" string="Field Mapping">
                    <field name="mapping_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="expression" />
                            <field
                                name="field_id"
                                options="{'no_create': True, 'no_open': True}"
                            />
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
